# Saída do build — reconstruída a cada publicação
site/

# Dados derivados: gerados por src/migrar.py e src/classificar.py
dados/manifesto.json
dados/*.map
dados/wp-*.json
dados/limpeza.json
dados/noindex.txt
dados/gone-410.txt

# Exceções do Search Console são versionadas: representam decisão editorial
!dados/excecoes.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Sistema
.DS_Store
Thumbs.db
*.swp

# Segredos — nunca commitar
.env
*.key

# Gasto acumulado com a API. Versionado de propósito: sem ele, cada
# execução do Actions recomeça do zero e o teto mensal nunca freia.
!dados/custo-api.json

# Rascunhos do modo ensaio: para leitura, nao para publicacao
rascunhos/
